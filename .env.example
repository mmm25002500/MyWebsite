# 站台
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase（未設定時前台改讀 src/lib/data/seed）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 只在 server 端使用（src/lib/supabase/service.ts）：寫入型 RPC 與後台的
# 使用者管理都經由它，因為那些函式已經收回 anon 的執行權。切勿加上
# NEXT_PUBLIC_ 前綴。
SUPABASE_SERVICE_ROLE_KEY=

# 快取與速率限制
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email（聯絡表單的站長通知信）
#
# 走 SMTP。MXroute 的話 host 是分配到的伺服器（例如 xxx.mxrouting.net），
# 帳號就是完整的信箱位址。587 走 STARTTLS，465 走隱式 TLS。
# 缺任何一項就不寄信，表單本身仍然正常收件。
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# 寄件位址，留空時沿用 SMTP_USER
SMTP_FROM=
# 收件位址：通知信要寄到哪
NOTIFY_EMAIL=

# 外部資料代理（僅 server 端使用）
# GITHUB_ACCOUNTS：要在首頁彙整的 GitHub 帳號與組織，逗號分隔
GITHUB_ACCOUNTS=
GITHUB_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# 防機器人（Cloudflare Turnstile）
# site key 會出現在前端，因此必須是 NEXT_PUBLIC_；secret 只在 server 端使用。
# Widget 的「主機名稱」記得同時加入 localhost，否則本機開發驗證不會過。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 反向代理
#
# 自架（非 Vercel）且前面有反向代理時設為 true，速率限制才取得到真實 IP。
# 沒有代理卻設成 true，訪客就能偽造 x-forwarded-for 繞過速率限制。
# Vercel 上不必設定，平台會自動注入 VERCEL=1。
TRUST_PROXY_HEADERS=false

# 快取失效
REVALIDATE_SECRET=

# Google AdSense
#
# 沒有設定 client 時整套廣告不存在：不載腳本、不渲染版位、不顯示同意橫幅，
# 而且 middleware 會維持嚴格的 CSP（廣告路徑的放寬只在有 client 時生效）。
# 通過 AdSense 審核後才拿得到這些值。
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_LIST=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# 錯誤監控
SENTRY_DSN=

# Supabase CLI（套用 migration、產生型別）
#
# 刻意不使用 `supabase login`：那會把憑證寫進全域的 ~/.supabase，只有一個位置，
# 有多個 Supabase 帳號時會互相蓋掉。改成把 token 放在這個檔案裡，憑證因此綁定
# 這個 repo，`pnpm db:*` 系列指令會自動載入。
#
# token 產生位置：https://supabase.com/dashboard/account/tokens
# 請在「擁有本專案的那個帳號」下產生。
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
# Dashboard → Settings → Database → Database password
SUPABASE_DB_PASSWORD=
