# 站台
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase（未設定時前台改讀 src/lib/data/seed）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 僅供 Supabase Edge Function 使用，不放進 Next.js 執行環境
SUPABASE_SERVICE_ROLE_KEY=

# 快取與速率限制
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Email（聯絡表單的站長通知信）
#
# RESEND_FROM_EMAIL 的網域必須在 Resend 後台驗證過，否則寄送會被擋下。
# 還沒有自有網域時可用 onboarding@resend.dev——那是 Resend 的共用寄件位址，
# 但只能寄給註冊 Resend 帳號的那個信箱。
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
NOTIFY_EMAIL=

# 外部資料代理（僅 server 端使用）
# GITHUB_ACCOUNTS：要在首頁彙整的 GitHub 帳號與組織，逗號分隔
GITHUB_ACCOUNTS=
GITHUB_TOKEN=
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# 防機器人（Cloudflare Turnstile）
# site key 會出現在前端，因此必須是 NEXT_PUBLIC_；secret 只在 server 端使用。
# Widget 的「主機名稱」記得同時加入 localhost，否則本機開發驗證不會過。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 快取失效
REVALIDATE_SECRET=

# 錯誤監控
SENTRY_DSN=

# Supabase CLI（套用 migration、產生型別）
#
# 刻意不使用 `supabase login`：那會把憑證寫進全域的 ~/.supabase，只有一個位置，
# 有多個 Supabase 帳號時會互相蓋掉。改成把 token 放在這個檔案裡，憑證因此綁定
# 這個 repo，`pnpm db:*` 系列指令會自動載入。
#
# token 產生位置：https://supabase.com/dashboard/account/tokens
# 請在「擁有本專案的那個帳號」下產生。
SUPABASE_PROJECT_ID=
SUPABASE_ACCESS_TOKEN=
# Dashboard → Settings → Database → Database password
SUPABASE_DB_PASSWORD=
