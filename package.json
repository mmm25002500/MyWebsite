{
  "name": "tershi-web",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "NEXT_DIST_DIR=.next-build next build",
    "start": "NEXT_DIST_DIR=.next-build next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "analyze": "ANALYZE=true NEXT_DIST_DIR=.next-build next build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "seed:generate": "tsx scripts/generate-seed.mts",
    "db:types": "set -a && . ./.env.local && set +a && npx supabase gen types typescript --project-id \"$SUPABASE_PROJECT_ID\" > src/types/database.ts",
    "db:link": "set -a && . ./.env.local && set +a && npx supabase link --project-ref \"$SUPABASE_PROJECT_ID\"",
    "db:push": "set -a && . ./.env.local && set +a && npx supabase db push",
    "db:diff": "set -a && . ./.env.local && set +a && npx supabase db diff",
    "db:whoami": "set -a && . ./.env.local && set +a && npx supabase projects list",
    "db:seed": "set -a && . ./.env.local && set +a && tsx scripts/db-seed.mts",
    "import:legacy": "set -a && . ./.env.local && set +a && tsx scripts/import-legacy.mts",
    "admin:create-owner": "set -a && . ./.env.local && set +a && tsx scripts/create-owner.mts",
    "admin:set-password": "set -a && . ./.env.local && set +a && tsx scripts/set-password.mts",
    "import:images": "set -a && . ./.env.local && set +a && tsx scripts/import-images.mts",
    "audit:secrets": "set -a && . ./.env.local && set +a && tsx scripts/audit-secrets.mts"
  },
  "dependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@phosphor-icons/react": "^2.1.7",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.47.10",
    "@uiw/codemirror-theme-github": "^4.25.11",
    "@uiw/react-codemirror": "^4.25.11",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "github-slugger": "^2.0.0",
    "gsap": "^3.12.5",
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.16.15",
    "lite-youtube-embed": "^0.3.3",
    "next": "^15.1.3",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.4",
    "nextjs-toploader": "^3.9.17",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.2",
    "rehype-katex": "^7.0.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^3.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "shiki": "^1.24.4",
    "swiper": "^14.2.0",
    "tailwind-merge": "^2.6.0",
    "ua-parser-js": "^1.0.39",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@hookform/resolvers": "^3.10.0",
    "@next/bundle-analyzer": "^15.1.3",
    "@tailwindcss/postcss": "^4.0.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/ua-parser-js": "^0.7.39",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "eslint-config-prettier": "^10.1.8",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "server-only": "^0.0.1",
    "supabase": "^2.117.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.13",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "postcss": "^8.5.23"
    }
  }
}
